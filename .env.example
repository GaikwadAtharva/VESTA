# VESTA Environment Variables Template

# Supabase (Frontend & Database)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# IBM Granite / watsonx.ai (Backend)
